{
  "name": "calixteportofolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "dev:api": "node server/server.js",
    "dev:media": "node server/mediaServer.js",
    "dev": "vite",
    "prebuild": "node scripts/sync-media.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:pages": "wrangler pages dev dist --port 8788",
    "preview:pages": "npm run build && wrangler pages dev dist --port 8788",
    "deploy:pages": "npm run build && wrangler pages deploy dist",
    "db:init:local": "wrangler d1 execute DB --local --file=./sql/d1-schema.sql",
    "db:seed:local": "wrangler d1 execute DB --local --file=./sql/d1-seed.sql",
    "db:init": "wrangler d1 execute DB --remote --file=./sql/d1-schema.sql",
    "db:seed": "wrangler d1 execute DB --remote --file=./sql/d1-seed.sql"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "gsap": "^3.15.0",
    "mariadb": "^3.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@hookform/devtools": "^4.4.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "vite": "^8.3.5",
    "wrangler": "^4.161.0"
  }
}
